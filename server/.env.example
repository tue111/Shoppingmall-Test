PORT=5000
# MongoDB Atlas 주소. 값이 있으면 이 주소를 쓰고, 비어 있을 때만 아래 로컬 주소(MONGODB_URI)를 사용
MONGODB_ATLAS_URL=
MONGODB_URI=mongodb://127.0.0.1:27017/shoppingmall
CLIENT_URL=http://localhost:5173

# 로그인 토큰 서명 키. 운영 환경에서는 반드시 긴 랜덤 문자열로 변경
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Cloudinary (상품 이미지 업로드). 대시보드 > Settings > API Keys 에서 확인
# API Secret은 서버에만 두고 절대 클라이언트로 보내지 않음
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# 업로드 폴더 (기본: shoppingmall/products)
CLOUDINARY_FOLDER=shoppingmall/products
